{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies",
    ":semanticCommits"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "rangeStrategy": "pin",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "minimumReleaseAge": "7 days"
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Never automerge anything: every update is a reviewed decision",
      "matchPackageNames": ["*"],
      "automerge": false
    },
    {
      "description": "Group GitHub Action updates so pins move together",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
